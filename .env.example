# === LLM & Embeddings ===
# Option A (default): OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
LLM_MODEL_ANSWER=gpt-4o
LLM_MODEL_GRADER=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Option B: fully local and free with Ollama (https://ollama.com):
#   ollama pull qwen2.5:3b && ollama pull nomic-embed-text
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL_ANSWER=qwen2.5:3b
# LLM_MODEL_GRADER=qwen2.5:3b
# VANNA_MODEL=qwen2.5:3b
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

# === Vector DB ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
# No Docker? Run Qdrant embedded on disk instead of as a server:
# QDRANT_PATH=./.localdev/qdrant

# === Postgres ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adv_rag
# Without Docker: `make local-up` starts Postgres on :5434, then use
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/adv_rag

# === Cache (Upstash) ===
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-redis-token
# Or a plain Redis server (used when Upstash is not set). Leave both empty to
# use the in-memory fallback.
REDIS_URL=
CACHE_TTL_EMBEDDINGS=604800        # 7 days
CACHE_TTL_RAG=3600                 # 1 hour
CACHE_TTL_SQL_GEN=86400            # 24 hours
CACHE_TTL_SQL_RESULT=900           # 15 min
CACHE_TTL_INTENT=86400             # 24 hours

# === Doc dedup ===
STORAGE_BACKEND=local              # or "s3"
S3_CACHE_BUCKET=adv-rag-cache
AWS_REGION=us-east-1

# === Web search ===
TAVILY_API_KEY=your-tavily-api-key

# === Auth ===
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MINUTES=60

# === Rate limit + budget ===
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TOKENS_PER_USER_DAILY=100000
AUTH_LOGIN_RATE_LIMIT_PER_MIN=5
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=3

# === Input restructuring ===
MAX_INPUT_TOKENS=3000
RESERVED_CONTEXT_TOKENS=1000
RESERVED_OUTPUT_TOKENS=1000

# === Security scanners ===
INPUT_GUARD_BACKEND=auto            # auto | llm_guard | heuristic
LLM_GUARD_SCANNERS=prompt_injection,toxicity,ban_topics
PII_BACKEND=auto                    # auto | llm_guard | regex

# === Security thresholds ===
PROMPT_INJECTION_THRESHOLD=0.75
TOXICITY_THRESHOLD=0.75
OUTPUT_TOXICITY_THRESHOLD=0.5
MAX_VALIDATION_RETRIES=2

# === Retrieval defaults ===
HYDE_NUM_HYPOTHESES=3
HYDE_ENABLED_BY_DEFAULT=false
HYBRID_SEARCH_ENABLED=true
RRF_K=60
RERANKER_BACKEND=local             # or "voyage"
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VOYAGE_API_KEY=
VOYAGE_MODEL=rerank-2.5
RERANKER_INITIAL_TOP_K=20
RERANKING_ENABLED_BY_DEFAULT=true
CRAG_RELEVANCE_THRESHOLD=0.7
CRAG_AMBIGUOUS_THRESHOLD=0.5
CRAG_ENABLED_BY_DEFAULT=true
REFLECTION_MIN_SCORE=0.85
MAX_REFLECTION_RETRIES=2
SELF_REFLECTIVE_ENABLED_BY_DEFAULT=false

# === Documents ===
DOC_PARSER=docling                  # docling | simple
MAX_UPLOAD_MB=20

# === Vanna (Text2SQL model settings) ===
VANNA_MODEL=gpt-4o
VANNA_TEMPERATURE=0.0
VANNA_SEED=42

SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=200

# === Server ===
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WARMUP_ON_STARTUP=false

# === Logging ===
LOG_JSON=false                     # true in prod
LOG_LEVEL=INFO
